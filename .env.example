# Veritabanı (geliştirme için SQLite). Üretimde PostgreSQL kullanmak için
# prisma/schema.prisma içindeki provider'ı "postgresql" yapıp URL'yi değiştirin.
DATABASE_URL="file:./dev.db"

# Oturum imzalama anahtarı — üretimde mutlaka uzun ve rastgele bir değer verin
AUTH_SECRET="degistir-beni-en-az-32-karakterlik-gizli-anahtar"

# Yüklenen belge ve görsellerin saklanacağı klasör
STORAGE_DIR="./storage"

# Site kökü (paylaşım bağlantıları ve meta etiketleri için)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
